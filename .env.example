# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Clerk publishable key for LifeHub accounts.
# Add the real value to Vercel Project Settings -> Environment Variables.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"

# Supabase project URL (base URL, NOT /rest/v1/).
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase publishable key. Safe for browser/client use when RLS is configured.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
